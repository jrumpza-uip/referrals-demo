                "max": 1,
                "step": 0.01
              },
              {
                "name": "inputs.maxTokenPerResponse",
                "type": "slider",
                "label": "Max. tokens per response",
                "defaultValue": 16384,
                "min": 0,
                "step": 1,
                "maxRef": {
                  "fromField": "inputs.modelMaxTokens",
                  "fallback": 16384
                }
              },
              {
                "name": "inputs.maxIterations",
                "type": "slider",
                "label": "Max. iterations",
                "defaultValue": 25,
                "min": 1,
                "max": 100,
